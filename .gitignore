# Codex creates new runtime directories and files during updates. Track only
# hand-maintained configuration, rules, and custom skills.
/*
!/.gitignore
!/config.toml
!/stride.config.toml
!/rules/
!/skills/

# Codex-managed skills are installed and updated by Codex
/skills/.system/

# Generated content inside custom skills
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.npm-cache/
**/node_modules/
**/.venv/
**/dist/
**/build/
*.orig
