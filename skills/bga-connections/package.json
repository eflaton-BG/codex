{
  "name": "bga-connections",
  "version": "1.5.5",
  "supportedPlatforms": [
    "linux",
    "macos",
    "windows"
  ],
  "entrypoints": {
    "linux": "install.sh",
    "macos": "install-macos.sh",
    "windows": "install.ps1"
  },
  "commands": {
    "linux": {
      "install": "curl -fsSL '{{ENTRYPOINT_URL}}' | sudo env CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\" bash",
      "uninstall": "curl -fsSL '{{ENTRYPOINT_URL}}' | sudo env CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\" bash -s -- --undo"
    },
    "macos": {
      "install": "curl -fsSL '{{ENTRYPOINT_URL}}' | sudo env BGA_CODEX_ENV_HOME=\"$HOME\" CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\" bash",
      "uninstall": "curl -fsSL '{{ENTRYPOINT_URL}}' | sudo env BGA_CODEX_ENV_HOME=\"$HOME\" CODEX_HOME=\"${CODEX_HOME:-$HOME/.codex}\" bash -s -- --undo"
    },
    "windows": {
      "install": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"iex (irm '{{ENTRYPOINT_URL}}')\"",
      "uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& ([scriptblock]::Create((irm '{{ENTRYPOINT_URL}}'))) -Undo\""
    }
  }
}
